# WiFi-lösenord och LAN-adresser stannar på den här disken (mönstret ärvt
# från Solceller: känsligt committas aldrig, se secrets.h.example).
secrets.h

# Lokal utvecklingsmiljö.
.venv/
__pycache__/
*.py[cod]

# Byggträd är regenererbara.
build/
build-*/
sim/build*/
managed_components/
# JS-beroenden hör hemma i tools/relay och tools/interaction-relay, som
# ignorerar sina egna node_modules. Regeln här fångar en npm install
# som råkat köras i fel katalog (610 ospårade filer, 2026-09-22).
node_modules/
sdkconfig
sdkconfig.old
.worktrees/

# Font-TTF:erna hämtas av platform/fonts/fetch-and-convert.sh; bara de
# genererade .c-filerna committas så bygget aldrig behöver node eller nät.
platform/fonts/src/
# Enhetens LAN-IP for tools/ota-flash.sh — miljospecifik, aldrig delad.
.ota-device
# Valfri GitHub-token för stjärnräknaren (tokenserver.py läser
# <repo>/.github-token) — en hemlighet, aldrig committad.
.github-token

# Agent-tooling state and scratch captures that appear in worktrees while
# working with Claude Code/Codex plugins. Never project source.
.superpowers/
.scratch-capture/
.DS_Store

# Konceptmockupernas SVG:er regenereras byte-identiskt av
# tools/mockups/gen_concept_mockups.py och gen_needsyou_v2.py. Dokumenten
# länkar alltid .png; SVG:erna var spårad utdata ingen läste.
docs/img/mockups/*.svg

# Private board backups and generated V2 configuration.
/backups/
/sdkconfig.241-v2*
